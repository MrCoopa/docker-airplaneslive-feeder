# Empfänger-Quelle (Host oder IP des Beast-Binary-Streams)
BEAST_HOST=dump1090
BEAST_PORT=30005

# Antennen-Standort (Erforderlich für Multilateration / MLAT)
LAT=50.1234
LON=8.1234
ALT=180m

# Name deiner Empfänger-Station auf https://airplanes.live/stations/
SITE_NAME=MeinRaspi-Station

# MLAT Einstellungen & Rückkanal auf die lokale tar1090 Karte
ENABLE_MLAT=true
MLAT_RESULTS_HOST=dump1090
MLAT_RESULTS_PORT=30004

# Optionale feste Feeder-UUID (wird sonst automatisch in /var/lib/airplaneslive/uuid generiert)
# UUID=
